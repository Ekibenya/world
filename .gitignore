__pycache__/
*.pyc
.DS_Store
.vercel/
tools/felinia/.ko-tab/
tools/felinia/.zh-ms/

# 沙盒有时会把自查用的小脚本、半截译稿丢在仓库根上 —— 那是它站着的地方。
# 运营指针第八节讲过这件事：只说文件名不说地方，就会落在这里。
# 真正的成品都有固定去处，落在根上的一律不入库。
/*.zh.ms.txt
/check_*.py
/tmp/
/_out/
/.tmp_zh/
image/**/.DS_Store

# 静态站点构建输出及桌面同步产生的同名副本，不入库
/_site*/

# Node.js dependencies
/node_modules/

# Local source corpus and extraction evidence; never publish the supplied novel files.
_work/

# 最终游戏只使用时代插画和按时代归档的角色立绘；组图与旧平铺切图留在本地工作区。
/art/sheets/
/art/portraits/*.png

# 原文抽取、生成报告与校验工作台只留在本地；仓库保存可运行游戏本身。
/tools/
/art/*.json
.env*
